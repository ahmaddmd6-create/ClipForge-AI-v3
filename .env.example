# ==============================================================================
# ClipForge AI - Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=ClipForge AI
APP_SECRET_KEY=clipforge_dev_secret_key_change_in_production_8941723891723
FRONTEND_ORIGIN=http://localhost:8080
LOG_LEVEL=INFO

# Database
POSTGRES_PASSWORD=clipforge_secure_postgres_pass_2026
DATABASE_URL=postgresql+psycopg://clipforge:clipforge_secure_postgres_pass_2026@db:5432/clipforge
REDIS_URL=redis://redis:6379/0

# Storage paths
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_MB=2048
MAX_SOURCE_DURATION_SECONDS=14400
OUTPUT_RETENTION_DAYS=30

# Clip Generation Parameters
DEFAULT_CLIP_COUNT=5
MIN_CLIP_DURATION_SECONDS=60
TARGET_CLIP_DURATION_SECONDS=75
MAX_CLIP_DURATION_SECONDS=90
DEFAULT_ASPECT_RATIO=9:16

# Worker Limits (CPU optimization)
MAX_CONCURRENT_JOBS=1
MAX_PARALLEL_RENDERS=1
CPU_THREADS=2
OMP_NUM_THREADS=2

# Transcription (faster-whisper CPU INT8)
TRANSCRIPTION_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGE=auto

# AI Analysis (local heuristic baseline or pluggable provider)
AI_PROVIDER=local
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional YouTube Data API Key
YOUTUBE_API_KEY=

# Security & CORS
ENABLE_AUTH=false
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
ANALYTICS_ENABLED=false
